{
  "name": "@antonsoloviev/dioptra",
  "version": "0.1.0",
  "private": true,
  "description": "Aim an unseen tunnel with Hero’s right-angle traverse, Greek instructions and an inspectable survey.",
  "type": "module",
  "author": "Anton Soloviev <anton@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/dioptra.git"
  },
  "homepage": "https://antonsoo.github.io/dioptra/",
  "keywords": [
    "ancient-greek",
    "geometry",
    "surveying",
    "hero-of-alexandria",
    "education",
    "dioptra"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4344 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4344 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:survey": "node --import tsx scripts/survey-cases.ts | python3 scripts/survey-oracle.py",
    "test:browser": "node scripts/browser-review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
